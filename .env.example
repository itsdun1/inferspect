# ─── LLM provider keys ───────────────────────────────────────────────
# At least one required. Gemini is the primary.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-32-byte-random-hex
BOOTSTRAP_ADMIN_EMAIL=admin@ollive.local
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Operator console (separate auth from chat-service)
CONSOLE_JWT_SECRET=change-me-32-byte-random-hex-operator
CONSOLE_BOOTSTRAP_EMAIL=operator@ollive.local
CONSOLE_BOOTSTRAP_PASSWORD=operator-change-me

# ─── Datastores (compose defaults; safe to leave) ────────────────────
POSTGRES_USER=ollive
POSTGRES_PASSWORD=ollivepass
POSTGRES_DB=ollive
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CLICKHOUSE_USER=ollive
CLICKHOUSE_PASSWORD=ollivepass
CLICKHOUSE_DB=ollive
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123

VALKEY_URL=redis://valkey:6379/0
# When connecting from the host (not from a compose container):
VALKEY_URL_HOST=redis://localhost:6380/0

GRAFANA_PASSWORD=admin

# ─── Service URLs (internal compose DNS) ─────────────────────────────
INGESTION_URL=http://ingestion-service:8001/v1/logs

# ─── SDK key → client tenant map ─────────────────────────────────────
# Ingestion side: JSON map of {sdk_key: client_name}
SDK_API_KEYS_JSON={"osk_dev_changeme": "chat-service"}

# Client side: the chat-service (or any customer) sets THEIR key:
SDK_API_KEY=osk_dev_changeme

# ─── Public URLs (override in prod) ──────────────────────────────────
PUBLIC_API_URL=http://localhost:8000

# ─── Frontend split (web-chat + web-insights) ────────────────────────
# In prod, both surfaces live on subdomains of DOMAIN:
#   chat.${DOMAIN}      → web-chat
#   insights.${DOMAIN}  → web-insights
# Each subdomain gets its own automatic Let's Encrypt cert via Caddy.
DOMAIN=152.70.79.7.nip.io

# Locally, skip subdomains and just expose ports (web-chat:3001, web-insights:3002)
# so you don't need to fiddle with /etc/hosts. The Caddy subdomain path only
# kicks in when running infra/docker-compose.prod.yml.
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000
NEXT_PUBLIC_INSIGHTS_API_URL=http://localhost:8003

# ─── PII redaction policy ────────────────────────────────────────────
PII_RECOGNIZERS=EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD,US_SSN,IBAN_CODE,IP_ADDRESS,PERSON,LOCATION
