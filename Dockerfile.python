# Shared Python image for all 5 services (chat-service, ingestion-service,
# insights-api, inference-consumer, app-log-consumer). Each compose service
# overrides the CMD with its own entrypoint.

FROM python:3.11-slim AS builder

# uv is the workspace tool — copy from the official image.
COPY --from=ghcr.io/astral-sh/uv:0.5.10 /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Cache deps first — only the pyproject + lockfile, no source yet.
COPY pyproject.toml uv.lock ./
COPY packages/chatbot-sdk/pyproject.toml packages/chatbot-sdk/
COPY apps/chat-service/pyproject.toml apps/chat-service/
COPY apps/ingestion-service/pyproject.toml apps/ingestion-service/
COPY apps/inference-consumer/pyproject.toml apps/inference-consumer/
COPY apps/app-log-consumer/pyproject.toml apps/app-log-consumer/
COPY apps/insights-api/pyproject.toml apps/insights-api/

# Pre-create source dirs so workspace resolution succeeds without source.
RUN mkdir -p packages/chatbot-sdk/chatbot_sdk \
             apps/chat-service/chat_service \
             apps/ingestion-service/ingestion_service \
             apps/inference-consumer/inference_consumer \
             apps/app-log-consumer/app_log_consumer \
             apps/insights-api/insights_api \
 && for d in packages/chatbot-sdk/chatbot_sdk apps/*/[a-z]*_service apps/*/[a-z]*_consumer apps/insights-api/insights_api; do touch $d/__init__.py 2>/dev/null || true; done

# Install all workspace deps into .venv (mounted volume in next stage).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --no-install-workspace --frozen

# Now copy the actual source and install workspace packages themselves.
COPY packages/chatbot-sdk packages/chatbot-sdk
COPY apps/chat-service apps/chat-service
COPY apps/ingestion-service apps/ingestion-service
COPY apps/inference-consumer apps/inference-consumer
COPY apps/app-log-consumer apps/app-log-consumer
COPY apps/insights-api apps/insights-api

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --frozen


# ─── Runtime image ───────────────────────────────────────────────
FROM python:3.11-slim AS runtime

RUN apt-get update -qq && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Bring across the populated venv + source.
COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

EXPOSE 8000 8001 8003

# Default command is overridden per service in compose.
CMD ["python", "-c", "print('set CMD per service in compose')"]
