{
  "uid": "ollive-cost",
  "title": "Cost & Tokens",
  "tags": ["ollive"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total spend (range)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT sumMerge(cost_state) AS total_usd FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cumulative spend per model",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT time, model AS metric, sum(bucket_cost) OVER (PARTITION BY model ORDER BY time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS value FROM (SELECT bucket AS time, model, sumMerge(cost_state) AS bucket_cost FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime GROUP BY bucket, model ORDER BY bucket) ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Total spend per model",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT model, sumMerge(cost_state) AS total_usd FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime GROUP BY model ORDER BY total_usd DESC",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top 20 conversations by spend",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "total_usd" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" },
              { "id": "decimals", "value": 4 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT toString(conversation_id) AS conversation_id, count() AS requests, sum(total_tokens) AS tokens, sum(cost_usd) AS total_usd FROM ollive.inference_logs WHERE started_at >= $__fromTime AND started_at <= $__toTime GROUP BY conversation_id ORDER BY total_usd DESC LIMIT 20",
          "format": "table"
        }
      ]
    }
  ]
}
