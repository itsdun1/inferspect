{
  "uid": "ollive-errors",
  "title": "Errors",
  "tags": ["ollive"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total errors (range)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT countMerge(error_count_state) AS errors FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate per provider (errors / total)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT bucket AS time, provider AS metric, countMerge(error_count_state) / greatest(countMerge(req_count_state), 1) AS value FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime GROUP BY bucket, provider ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cancelled conversation rate",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT bucket AS time, provider AS metric, countMerge(cancelled_count_state) / greatest(countMerge(req_count_state), 1) AS value FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime GROUP BY bucket, provider ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top error_codes by count",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT coalesce(error_code, '<none>') AS error_code, provider, count() AS count, any(error_message) AS sample_message FROM ollive.inference_logs WHERE started_at >= $__fromTime AND started_at <= $__toTime AND status = 'error' GROUP BY error_code, provider ORDER BY count DESC LIMIT 50",
          "format": "table"
        }
      ]
    }
  ]
}
