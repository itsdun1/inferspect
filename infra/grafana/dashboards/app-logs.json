{
  "uid": "ollive-app-logs",
  "title": "Application Logs",
  "tags": ["ollive"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse-ollive"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "query": {
          "refId": "service",
          "rawSql": "SELECT DISTINCT service FROM ollive.application_logs ORDER BY service",
          "format": "table"
        },
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": "",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          { "selected": false, "text": "debug", "value": "debug" },
          { "selected": false, "text": "info", "value": "info" },
          { "selected": false, "text": "warning", "value": "warning" },
          { "selected": false, "text": "error", "value": "error" },
          { "selected": false, "text": "critical", "value": "critical" }
        ],
        "query": "debug,info,warning,error,critical"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Error log count (range)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT count() AS errors FROM ollive.application_logs WHERE ts >= $__fromTime AND ts <= $__toTime AND level IN ('error', 'critical')",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log count per service + level (stacked)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT toStartOfInterval(ts, INTERVAL 1 MINUTE) AS time, concat(service, ' / ', level) AS metric, count() AS value FROM ollive.application_logs WHERE ts >= $__fromTime AND ts <= $__toTime AND (service IN (${service:sqlstring}) OR length([${service:sqlstring}]) = 0) AND (level IN (${level:sqlstring}) OR length([${level:sqlstring}]) = 0) GROUP BY time, service, level ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Recent application logs",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 14 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT ts AS timestamp, message AS body, level, service, logger, toString(trace_id) AS trace_id FROM ollive.application_logs WHERE ts >= $__fromTime AND ts <= $__toTime AND (service IN (${service:sqlstring}) OR length([${service:sqlstring}]) = 0) AND (level IN (${level:sqlstring}) OR length([${level:sqlstring}]) = 0) ORDER BY ts DESC LIMIT 500",
          "format": "logs"
        }
      ]
    }
  ]
}
