{
  "uid": "ollive-throughput",
  "title": "Throughput",
  "tags": ["ollive"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total requests (range)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT countMerge(req_count_state) AS total FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg requests / min",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT countMerge(req_count_state) / greatest(dateDiff('minute', $__fromTime, $__toTime), 1) AS rpm FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime",
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests / min per provider",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT bucket AS time, provider AS metric, countMerge(req_count_state) / 5.0 AS value FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime GROUP BY bucket, provider ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tokens / min (prompt + completion stacked)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ollive"
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ollive"
          },
          "rawSql": "SELECT bucket AS time, 'prompt_tokens' AS metric, sumMerge(prompt_tokens_state) / 5.0 AS value FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime GROUP BY bucket UNION ALL SELECT bucket AS time, 'completion_tokens' AS metric, sumMerge(completion_tokens_state) / 5.0 AS value FROM ollive.mv_inference_5m WHERE bucket >= $__fromTime AND bucket <= $__toTime GROUP BY bucket ORDER BY time",
          "format": "time_series"
        }
      ]
    }
  ]
}
