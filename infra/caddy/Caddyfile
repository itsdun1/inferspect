# Caddy reverse proxy for the hosted demo.
#
# Two independent subdomains so the two surfaces have independent cookies,
# brands, and deploy cadences:
#   - chat.${DOMAIN}      → end-user chat product (web-chat)
#   - insights.${DOMAIN}  → operator console (web-insights)
#
# Each subdomain gets its own automatic Let's Encrypt cert (Caddy default).
# The cookies are scoped per subdomain (no `Domain=.${DOMAIN}`), so
# `chat_session` lives only on chat.* and `console_session` lives only on
# insights.* — signing out of one does not affect the other.

# ─── End-user chat surface ────────────────────────────────────────────
chat.{$DOMAIN} {
    # /api/chat/auth/login → chat-service:/auth/login
    # chat-service mounts routers at root, so strip the /api/chat prefix.
    # chat-service runs inside the multipass VM (so the eBPF agent can
    # observe its SSL_writes), not as a Docker compose service. Caddy
    # reaches it via host.docker.internal which Docker Desktop maps to the
    # host gateway; multipass forwards port 8000 to localhost.
    handle_path /api/chat/* {
        reverse_proxy host.docker.internal:8000
    }

    # /api/logs/* → ingestion-service. The chat UI itself doesn't currently
    # POST app logs, but exposing this here keeps SDK-from-browser as a
    # future option without another Caddy round-trip.
    handle_path /api/logs/* {
        reverse_proxy ingestion-service:8001
    }

    # /api/control/* → ingestion-service. The eBPF agent (Phase G) talks to
    # ingestion via the chat subdomain — same TLS path as /api/logs.
    # ``handle`` (no path strip) preserves the /v1/control/* path the
    # ingestion controller expects. We rewrite /api/control/poll →
    # /v1/control/poll explicitly.
    handle /api/control/* {
        uri strip_prefix /api
        rewrite * /v1{uri}
        reverse_proxy ingestion-service:8001
    }

    # Everything else → web-chat Next.js (port 3000 inside the container).
    handle {
        reverse_proxy web-chat:3000
    }

    encode gzip zstd
}

# ─── Operator / insights console ──────────────────────────────────────
insights.{$DOMAIN} {
    # /api/insights/summary → insights-api:/insights/summary
    # The insights API mounts everything under /insights/, so KEEP the
    # prefix — just rewrite /api/insights/foo → /insights/foo.
    handle /api/insights/* {
        uri strip_prefix /api
        reverse_proxy insights-api:8003
    }

    # /api/admin/* and /api/auth/* → insights-api (operator login + admin
    # endpoints live there since Phase D). Use `handle` + `uri strip_prefix`
    # so we strip `/api` but keep `/admin/*` / `/auth/*` for insights-api,
    # which mounts those routers at root.
    handle /api/admin/* {
        uri strip_prefix /api
        reverse_proxy insights-api:8003
    }
    handle /api/auth/* {
        uri strip_prefix /api
        reverse_proxy insights-api:8003
    }

    # /api/agents/* and /api/enforcement-events/* → insights-api
    # (Phase G — operator agent fleet + enforcement log).
    # Match the bare prefix too — the web UI hits ``/api/agents`` exactly to
    # list the fleet; without both forms Caddy falls through to Next.js → 404.
    @agents path /api/agents /api/agents/*
    handle @agents {
        uri strip_prefix /api
        reverse_proxy insights-api:8003
    }
    @enforce path /api/enforcement-events /api/enforcement-events/*
    handle @enforce {
        uri strip_prefix /api
        reverse_proxy insights-api:8003
    }

    # Everything else → web-insights Next.js.
    handle {
        reverse_proxy web-insights:3000
    }

    encode gzip zstd
}
