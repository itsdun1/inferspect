# Copy this file to `secrets.env` (which is gitignored) and fill in real
# values. The prod kustomization.yaml's secretGenerator reads `secrets.env`
# to build the `ollive-secrets` Secret. NEVER commit `secrets.env`.
POSTGRES_PASSWORD=replace-me
CLICKHOUSE_PASSWORD=replace-me
GRAFANA_PASSWORD=replace-me
JWT_SECRET=replace-me-with-32-byte-random-hex
SDK_API_KEY=replace-me
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BOOTSTRAP_ADMIN_PASSWORD=replace-me
